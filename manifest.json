{
    "manifest_version": 3,
    "name": "Wiki2Grok",
    "version": "1.0.0",
    "description": "Automatically redirects Wikipedia links to Grokipedia articles",
    "author": "Wiki2Grok",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage",
        "webNavigation"
    ],
    "host_permissions": [
        "*://*.wikipedia.org/*"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    }
}